import numpy as np
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import PolynomialFeatures
from sklearn.metrics import mean_squared_error

# Dataset
X = np.array([[1], [2], [3], [4], [5]])
y = np.array([2, 8, 18, 32, 50])

# Linear Regression
linear = LinearRegression()
linear.fit(X, y)
linear_pred = linear.predict(X)

# Polynomial Regression
poly = PolynomialFeatures(degree=2)
X_poly = poly.fit_transform(X)

polynomial = LinearRegression()
polynomial.fit(X_poly, y)
poly_pred = polynomial.predict(X_poly)

# Display results
print("Linear Regression Predictions:", linear_pred)
print("Polynomial Regression Predictions:", poly_pred)

print("Linear MSE:", mean_squared_error(y, linear_pred))
print("Polynomial MSE:", mean_squared_error(y, poly_pred))

# Plot graph
plt.scatter(X, y, color='red', label='Actual Data')
plt.plot(X, linear_pred, label='Linear Regression')
plt.plot(X, poly_pred, label='Polynomial Regression')

plt.xlabel("X")
plt.ylabel("Y")
plt.title("Linear vs Polynomial Regression")
plt.legend()
plt.show()
